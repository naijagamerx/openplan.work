# OpenPlan / LazyMan Tools — root .htaccess
# Goal: deny direct HTTP access to sensitive files at the project root.
# Apache 2.4 (Hostinger). All app traffic enters through index.php (or mobile-logout.php / mobile/index.php).

# 1. Block all dotfiles (.env, .env.local, .git, .htaccess itself, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 2. Block sensitive file extensions and dependency manifests at the root
<FilesMatch "\.(zip|tar|tar\.gz|tgz|gz|bz2|7z|rar|lock|log|sql|sqlite|db|bak|backup|swp|swo|orig|ini|cfg|conf|config|key|pem|crt|cer|p12|pfx|properties|jks|keystore)$">
    Require all denied
</FilesMatch>

# 3. Block specific admin / utility / metadata files
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|migrate\.php|setup_models\.php|manifest\.php|release-manifest\.json|verify_manifest\.php|README(\.md)?|FILE_MANIFEST(\.md)?|RESTORATION_REPORT(\.md)?|projectstatus(\.md)?|test_ftp.*|user-manual.*\.png|insert_timer\.py)$">
    Require all denied
</FilesMatch>

# 4. Block direct access to internal directories that shouldn't be served
#    release-artifacts is handled separately below so its public android/
#    subfolder (APK downloads) can stay web-accessible.
RedirectMatch 403 ^/(includes|data|cron|datass|migration_backups|vendor|tests|test|scripts)(/|$)
# 4a. Lock down release-artifacts EXCEPT the public Android APK folder.
#     Negative lookahead keeps /release-artifacts/*.zip and /release-artifacts/data
#     blocked while allowing /release-artifacts/android/<file>.apk.
RedirectMatch 403 ^/release-artifacts(?!/android(/|$))

# 4b. Dot-folders and source trees, at any depth. Rule 1 only matches a file whose
#     own name starts with a dot, so /.git/config and /.zcode/config.json were served.
#     RewriteRule paths are relative to this folder, so this also works when the app
#     is installed in a subfolder (e.g. /taskmanager/). ACME's .well-known stays open.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
    RewriteRule ^(android|flutter_app|mcp-server)(/|$) - [F,L]
    # alexa-skill/ stays private except the interaction model the setup page links to.
    RewriteRule ^alexa-skill(/(?!interaction-model\.json$)|$) - [F,L]
    # Same folders as rule 4. RedirectMatch there is anchored at the domain root, so
    # it misses subfolder installs (/openplan/data/users.json was served); these are not.
    RewriteRule ^(includes|data|cron|datass|migration_backups|vendor|tests|test|scripts)(/|$) - [F,L]
    RewriteRule ^release-artifacts(?!/android(/|$)) - [F,L]
</IfModule>

# 5. Standard hardening: disable directory listing
Options -Indexes

# 6. Hide PHP version
ServerSignature Off
