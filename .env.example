# OpenPlan environment file
# Copy to .env next to config.php and fill in what you use. Every key is optional:
# the app installs and runs with no .env at all (open /?page=setup in a browser).
# .env is blocked from the web by the root .htaccess. Never commit your real .env.

# ---- Branding ----
APP_DISPLAY_NAME=OpenPlan
APP_TAGLINE=Focused task and productivity management for modern teams.

# ---- Email (password reset, verification, invoices, contact form) ----
# MAIL_DRIVER is "mail" (PHP mail()) or "smtp".
MAIL_DRIVER=mail
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=15
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=OpenPlan
# Where the public contact form sends messages (falls back to MAIL_FROM_ADDRESS).
CONTACT_EMAIL=
# Turn these on only once email sending works.
EMAIL_VERIFICATION_ENABLED=0
PASSWORD_RESET_ENABLED=0

# ---- Legal pages (Terms, Privacy, Refunds) ----
# Who runs THIS site. South African law (ECTA s43) expects an online seller to
# publish these; the pages show a notice until name, address and email are set.
# LEGAL_EMAIL falls back to CONTACT_EMAIL (never to the sending address).
LEGAL_OPERATOR_NAME=
# e.g. "sole proprietor" or "private company"
LEGAL_OPERATOR_STATUS=
LEGAL_REGISTRATION_NUMBER=
# Companies only: where the company is registered and its directors
LEGAL_REGISTERED_IN=
LEGAL_OFFICE_BEARERS=
# Physical address; it is also where legal documents can be served.
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_EMAIL=
# The law that governs the Terms, e.g. "South Africa"
LEGAL_COUNTRY=
# POPIA Information Officer; defaults to LEGAL_OPERATOR_NAME
LEGAL_INFORMATION_OFFICER=
# Link to your PAIA manual (every SA private body needs one since 2022)
LEGAL_PAIA_MANUAL_URL=

# ---- Scheduled jobs ----
# External cron calls api/cron.php?action=run&cron_key=... and are refused until
# this is set to a long random value (for example: openssl rand -base64 32).
LAZYMAN_CRON_KEY=
AI_CRON_ENABLED=true

# ---- Background jobs and voice owner mode ----
# Needed only for features that run with nobody signed in (scheduled AI briefs,
# Alexa owner mode). It is the master password of ONE account; leave it empty
# unless you need those features, and keep this file readable only by PHP.
LAZYMAN_MASTER_PASSWORD=

# ---- Native app device tokens ----
# Optional extra secret mixed into stored device-token hashes. Set it BEFORE
# pairing any phone: setting or changing it later signs out every paired device.
DEVICE_TOKEN_PEPPER=

# ---- Alexa skill (optional) ----
# Owner mode answers for one OpenPlan account with no account linking.
# ALEXA_SKILL_ID is required for it: requests from any other skill are refused.
ALEXA_SKILL_ID=
ALEXA_OWNER_USER_ID=
# Recommended: your own Amazon user ID (amzn1.ask.account...), so nobody else who
# enables the skill gets your data. Use the skill once; the PHP error log prints it.
ALEXA_OWNER_AMAZON_USER_ID=
# Account linking (multi-user). Platform key = base64 of 32 random bytes.
ALEXA_OAUTH_CLIENT_ID=openplan-alexa
ALEXA_OAUTH_CLIENT_SECRET=
ALEXA_PLATFORM_KEY=
# Local testing only. Never set this on a public server.
ALEXA_DEV_BYPASS_SIGNATURE=0

# ---- Card payments: PayFast (South Africa, ZAR) ----
# Leave the merchant ID empty to hide the "Pay by card" button. Set the same
# passphrase as in PayFast > Settings > Security (required for subscriptions).
# PAYFAST_SANDBOX stays on until you set it to 0, so test with your sandbox
# merchant first. PAYFAST_SITE_URL is the public address PayFast sends people
# back to and posts payment notifications to, e.g. https://example.com
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=1
PAYFAST_SITE_URL=
# Only if the site is behind a proxy/CDN and payment notifications are refused
# with "source address not PayFast" in the PHP error log.
PAYFAST_TRUST_PROXY=0

# ---- Free trial (no card) ----
# Lets each new account try the AI on YOUR shared keys (Admin -> Shared AI Keys),
# once. Off by default because it spends your AI money. When email verification
# is on, the email must be verified first.
TRIAL_ENABLED=0
TRIAL_DAYS=14
TRIAL_REQUESTS=50
# Providers the trial may use (needs a shared key for each). Groq is fast and cheap.
TRIAL_PROVIDERS=groq
# Optional: limit the trial to certain shared models, e.g. groq:llama-3.1-8b-instant
TRIAL_MODELS=

# ---- Images ----
IMAGE_SERVICE_ENABLED=0
IMAGE_SERVICE_PROVIDER=

# ---- Troubleshooting (local development only) ----
LAZYMAN_DEBUG=0
LAZYMAN_ALLOW_INSECURE_SSL=0
